<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6f3b2a7e-4c1d-4e8a-9b0f-a5d2c7e91f40</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>PANASIA MRO</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="AM DATA"/>
  <Description DefaultValue="메일의 선박 AM DATA 를 Outlook 오른쪽 패널에 표시 (PC 의 AM-Ai Coordi 앱과 연결)"/>
  <IconUrl DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-128.png"/>
  <SupportUrl DefaultValue="https://logannyd.github.io/am-coordi-owa/"/>
  <AppDomains>
    <AppDomain>https://logannyd.github.io/am-coordi-owa</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://logannyd.github.io/am-coordi-owa/index.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://logannyd.github.io/am-coordi-owa/index.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="amaiGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="amaiOpen">
                    <Label resid="btnLabel"/>
                    <Supertip><Title resid="btnLabel"/><Description resid="btnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="paneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="amaiGroupC">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="amaiOpenC">
                    <Label resid="btnLabel"/>
                    <Supertip><Title resid="btnLabel"/><Description resid="btnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="paneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="paneUrl" DefaultValue="https://logannyd.github.io/am-coordi-owa/index.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="AM DATA"/>
          <bt:String id="btnLabel" DefaultValue="AM DATA"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="btnDesc" DefaultValue="이 메일의 선박 AM DATA(관리대장 호선 정보 · 견적/수주 · MAGIC PORT)를 오른쪽 패널에 표시합니다."/>
        </bt:LongStrings>
      </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="amaiGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="amaiOpen">
                    <Label resid="btnLabel"/>
                    <Supertip><Title resid="btnLabel"/><Description resid="btnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="paneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="amaiGroupC">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="amaiOpenC">
                    <Label resid="btnLabel"/>
                    <Supertip><Title resid="btnLabel"/><Description resid="btnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="paneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://logannyd.github.io/am-coordi-owa/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="paneUrl" DefaultValue="https://logannyd.github.io/am-coordi-owa/index.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="AM DATA"/>
          <bt:String id="btnLabel" DefaultValue="AM DATA"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="btnDesc" DefaultValue="이 메일의 선박 AM DATA(관리대장 호선 정보 · 견적/수주 · MAGIC PORT)를 오른쪽 패널에 표시합니다."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
